# 복사해서 사용: cp .env.example .env  (없어도 기본값으로 동작)
# ops/compose.yaml이 api·worker·studio 컨테이너에 이 파일을 넘긴다.

# 운영에서는 반드시 바꿀 것
JWT_SECRET=change-me-in-production

# 시드 계정 비밀번호 (writer1@example.com, producer1@example.com, admin@example.com 등)
SEED_PASSWORD=password1234

# AI 요약: 키가 있으면 Claude, 없으면 mock 요약기. AI_SUMMARIZER=mock|claude로 강제 가능
ANTHROPIC_API_KEY=
# AI_SUMMARIZER=mock

# 호스트 포트를 바꾸려면 셸에서 지정: STUDIO_PORT=3001 API_PORT=4001 DB_PORT=5433 pnpm up
