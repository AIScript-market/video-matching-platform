# 운영(베타) 환경 변수 예시. 복사해서 값을 채운다: cp ops/prod/production.env.example ops/prod/production.env
# production.env는 비밀값이 들어가므로 저장소에 넣지 않는다 (.gitignore가 막는다).

# 서비스 도메인 (DNS A 레코드가 이 서버를 가리켜야 Caddy가 HTTPS 인증서를 받는다)
SITE_DOMAIN=beta.example.com
WEB_ORIGIN=https://beta.example.com

# 비밀값: 각각 긴 무작위 문자열로 (예: openssl rand -base64 48)
POSTGRES_PASSWORD=
JWT_SECRET=

# 초대제 베타
BETA_MODE=true
# 쉼표로 여러 개. 묶음(1차 작가, 1차 제작팀 등)마다 다른 코드를 주면 나중에 구분하기 쉽다
BETA_INVITE_CODES=
BETA_SIGNUP_COINS=100

# 계약서에 적힐 플랫폼 운영자 이름 (사업자 등록 뒤 상호로 바꾼다)
PLATFORM_LEGAL_NAME=

# 약관·개인정보 처리방침·문의에 보일 운영자 이메일
CONTACT_EMAIL=

# AI 요약: 공개 소개 글(제목·장르·로그라인·시놉시스)만 Google Gemini API로 보내 요약한다. 전문은 보내지 않는다 (docs/deploy.md 4-2)
# 키는 결제(유료 등급)가 연결된 프로젝트의 것이어야 한다. 무료 등급 키는 보낸 글을 Google이 제품 개선에 쓸 수 있다
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# 키가 없으면 mock 요약기(시놉시스를 그대로 요약으로). AI_SUMMARIZER=gemini|claude|mock 으로 고정할 수 있다
# AI_SUMMARIZER=gemini

# 검수용 영상 저장소 (Cloudflare R2, docs/deploy.md 4-1). 비워 두면 영상은 링크로만 제출받는다
VIDEO_STORAGE_ENDPOINT=https://<계정 ID>.r2.cloudflarestorage.com
VIDEO_STORAGE_BUCKET=vmp-videos
VIDEO_STORAGE_ACCESS_KEY_ID=
VIDEO_STORAGE_SECRET_ACCESS_KEY=
VIDEO_STORAGE_REGION=auto

# API 문서(/docs)를 운영에서도 열려면 on
# API_DOCS=on
