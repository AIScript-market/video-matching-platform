// 계약 ERD (CLAUDE 계약 문서 기준). 컨벤션: @@map 없음(테이블명=모델명), id는 cuid,
// 금액은 원 단위 Int, 시간은 UTC DateTime. 각자 자기 모델만 수정하고 마이그레이션 이름에 a-/b- 접두어.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 계정 종류는 일반(roles = [])과 관리자(ADMIN) 두 가지. WRITER·PRODUCER는 이전 계약 호환용으로만 남아 있고 쓰지 않는다
enum Role {
  WRITER
  PRODUCER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED // 관리자가 정지. 이 이메일로는 다시 가입할 수 없다
  WITHDRAWN // 탈퇴. 이메일을 비워 두어 같은 이메일로 다시 가입할 수 있다
}

enum CoinTxType {
  SIGNUP_BONUS
  PURCHASE
  SPEND
  ADMIN_ADJUST
}

// 코인을 쓰는 곳
enum CoinUse {
  MESSAGE
  PREVIEW_UNLOCK
  SCRIPT_UPLOAD
}

enum ScriptStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NegotiationStatus {
  OPEN
  AGREED
  CLOSED
}

enum OfferStatus {
  PROPOSED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DealStatus {
  PENDING_CONTRACT
  ACTIVE
  TERMINATED
}

enum LicenseStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum LedgerEntryType {
  REVENUE
  PAYOUT
  FEE
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  roles        Role[]
  createdAt    DateTime @default(now())

  /// 공개 프로필 소개. 대본 제공·영상 제작을 하려면 프로필과 이메일을 공개해야 한다
  bio             String?
  profilePublic   Boolean    @default(false)
  emailPublic     Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  suspendedAt     DateTime?
  suspendReason   String?
  withdrawnAt     DateTime?
  coinBalance     Int        @default(0)
  /// 가입 때 동의한 이용약관·개인정보 처리방침 버전과 시각 (베타부터 기록)
  termsVersion    String?
  termsAcceptedAt DateTime?

  scripts              Script[]
  accessRequests       ScriptAccessRequest[]
  accessLogs           ScriptAccessLog[]
  writerNegotiations   Negotiation[]         @relation("NegotiationWriter")
  producerNegotiations Negotiation[]         @relation("NegotiationProducer")
  messages             Message[]
  offers               Offer[]
  licenses             License[]
  ledgerEntries        LedgerEntry[]
  scriptUploads        ScriptUpload[]
  coinTransactions     CoinTransaction[]
  previewUnlocks       ScriptPreviewUnlock[]
  reportsFiled         AccountReport[]       @relation("ReportsFiled")
  reportsReceived      AccountReport[]       @relation("ReportsReceived")
  reportsResolved      AccountReport[]       @relation("ReportsResolved")
  inquiries            Inquiry[]             @relation("InquiryAuthor")
  inquiryReplies       InquiryReply[]        @relation("InquiryReplyAuthor")

  identity           IdentityVerification?
  talentProfile      TalentProfile?            @relation("TalentUser")
  wards              TalentProfile[]           @relation("TalentGuardian")
  castingOffers      CastingOffer[]
  takedownRequests   TakedownRequest[]         @relation("TakedownRequester")
  takedownDecisions  TakedownRequest[]         @relation("TakedownDecider")
  likenessAccess     LikenessAccessLog[]
  performanceRecords WorkPerformanceSnapshot[]

  contractParties ContractParty[]
  channelVideos   ChannelVideo[]     @relation("ChannelVideoProducer")
  videoReviews    ChannelVideo[]     @relation("ChannelVideoReviewer")
  revenueRecords  VideoRevenue[]
  payoutsReceived SettlementPayout[] @relation("PayoutRecipient")
  payoutsRecorded SettlementPayout[] @relation("PayoutCreator")
}

model Script {
  id                   String       @id @default(cuid())
  authorId             String
  author               User         @relation(fields: [authorId], references: [id])
  title                String
  logline              String
  synopsis             String
  genre                String
  fullText             String       @db.Text
  status               ScriptStatus @default(DRAFT)
  rightsDeclared       Boolean      @default(false)
  rightsDeclaredAt     DateTime?
  aiSummary            Json?
  /// 마지막으로 AI 요약을 요청한 시각. aiSummary.generatedAt보다 나중이면 새 요약을 만드는 중
  aiSummaryRequestedAt DateTime?
  /// 제작자에게 열람 승인 전에 보여줄 일부분 (선택)
  previewText          String?      @db.Text
  /// 내용(제목·로그라인·시놉시스·장르·전문·미리보기)이 마지막으로 바뀐 시각. 공개·숨김 같은 상태 변경은 포함하지 않는다
  contentUpdatedAt     DateTime     @default(now())
  /// 흥행 판단 모델의 학습 데이터로 이 대본(의 벡터)을 써도 된다는 작가의 동의 (선택, 기본 동의 안 함)
  trainingConsent      Boolean      @default(false)
  trainingConsentAt    DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  accessRequests ScriptAccessRequest[]
  accessLogs     ScriptAccessLog[]
  negotiations   Negotiation[]
  licenses       License[]
  uploads        ScriptUpload[]
  previewUnlocks ScriptPreviewUnlock[]
  reports        AccountReport[]
  embeddings     ScriptEmbedding[]
}

model ScriptAccessRequest {
  id            String              @id @default(cuid())
  scriptId      String
  script        Script              @relation(fields: [scriptId], references: [id])
  producerId    String
  producer      User                @relation(fields: [producerId], references: [id])
  status        AccessRequestStatus @default(PENDING)
  ndaAcceptedAt DateTime
  decidedAt     DateTime?
  ndaContract   Contract?

  @@unique([scriptId, producerId])
}

model ScriptAccessLog {
  id       String   @id @default(cuid())
  scriptId String
  script   Script   @relation(fields: [scriptId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  viewedAt DateTime @default(now())
}

model Negotiation {
  id         String            @id @default(cuid())
  scriptId   String
  script     Script            @relation(fields: [scriptId], references: [id])
  writerId   String
  writer     User              @relation("NegotiationWriter", fields: [writerId], references: [id])
  producerId String
  producer   User              @relation("NegotiationProducer", fields: [producerId], references: [id])
  status     NegotiationStatus @default(OPEN)
  createdAt  DateTime          @default(now())

  messages Message[]
  offers   Offer[]
  deal     Deal?

  @@unique([scriptId, producerId])
}

model Message {
  id            String      @id @default(cuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id])
  body          String
  createdAt     DateTime    @default(now())
}

model Offer {
  id               String      @id @default(cuid())
  negotiationId    String
  negotiation      Negotiation @relation(fields: [negotiationId], references: [id])
  proposerId       String
  proposer         User        @relation(fields: [proposerId], references: [id])
  writerSharePct   Int
  producerSharePct Int
  upfrontFeeKrw    Int
  termMonths       Int
  exclusive        Boolean
  notes            String?
  status           OfferStatus @default(PROPOSED)
  createdAt        DateTime    @default(now())
}

model Deal {
  id              String      @id @default(cuid())
  negotiationId   String      @unique
  negotiation     Negotiation @relation(fields: [negotiationId], references: [id])
  acceptedOfferId String
  status          DealStatus  @default(PENDING_CONTRACT)
  createdAt       DateTime    @default(now())

  licenses      License[]
  ledgerEntries LedgerEntry[]
  project       Project?
  /// 대본 이용허락 계약과 그 변경 계약들
  contracts     Contract[]
  videos        ChannelVideo[]
}

model License {
  id                String        @id @default(cuid())
  dealId            String
  deal              Deal          @relation(fields: [dealId], references: [id])
  scriptId          String
  script            Script        @relation(fields: [scriptId], references: [id])
  licenseeId        String
  licensee          User          @relation(fields: [licenseeId], references: [id])
  scope             String        @db.Text
  startsAt          DateTime?
  endsAt            DateTime?
  status            LicenseStatus @default(DRAFT)
  terminationReason String?
}

model LedgerEntry {
  id          String          @id @default(cuid())
  dealId      String
  deal        Deal            @relation(fields: [dealId], references: [id])
  type        LedgerEntryType
  amountKrw   Int
  memo        String?
  occurredAt  DateTime
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
}

enum UploadKind {
  FULL // 대본 전문
  PREVIEW // 미리보기 대본
}

// 대본 파일 업로드 기록 (관리자 로그용). 원본 파일은 저장하지 않고 추출한 본문만 Script.fullText에 넣는다
model ScriptUpload {
  id         String     @id @default(cuid())
  scriptId   String
  script     Script     @relation(fields: [scriptId], references: [id])
  uploaderId String
  uploader   User       @relation(fields: [uploaderId], references: [id])
  kind       UploadKind @default(FULL)
  filename   String
  mimeType   String
  sizeBytes  Int
  charCount  Int
  createdAt  DateTime   @default(now())

  @@index([createdAt])
}

// 코인 거래 원장. amount는 + 충전 / - 사용, balanceAfter는 거래 직후 잔액
model CoinTransaction {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  type         CoinTxType
  amount       Int
  balanceAfter Int
  use          CoinUse?
  /// 사용처 대상 id (메시지·대본 등)
  refId        String?
  /// 구매 시 결제 금액 (원)
  priceKrw     Int?
  memo         String?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// 미리보기 대본 열람권 (코인으로 한 번 사면 계속 볼 수 있다)
model ScriptPreviewUnlock {
  id        String   @id @default(cuid())
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([scriptId, userId])
}

enum ReportReason {
  SPAM // 스팸·홍보
  ABUSE // 욕설·괴롭힘
  FRAUD // 사기·금전 요구
  COPYRIGHT // 저작권 침해 (타인의 대본 등)
  INAPPROPRIATE // 부적절한 콘텐츠
  OTHER
}

enum ReportStatus {
  OPEN // 처리 전
  RESOLVED // 조치함
  DISMISSED // 문제없음으로 기각
}

// 계정 신고. 같은 신고자가 같은 계정에 대해 처리 전(OPEN) 신고를 둘 이상 둘 수 없다 (서비스에서 확인)
model AccountReport {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id])
  targetId       String
  target         User         @relation("ReportsReceived", fields: [targetId], references: [id])
  reason         ReportReason
  details        String?      @db.Text
  /// 어느 대본에서 신고했는지 (선택)
  scriptId       String?
  script         Script?      @relation(fields: [scriptId], references: [id])
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?        @relation("ReportsResolved", fields: [resolvedById], references: [id])
  resolutionNote String?

  @@index([targetId, status])
  @@index([status, createdAt])
  @@index([reporterId, targetId, status])
}

// ---------------------------------------------------------------------------
// B: 출연자 등록·캐스팅·작품 공개. 기준: docs/policies/likeness-policy.md
// 계정은 일반 계정 그대로 쓰고, 출연자는 TalentProfile, 보호자는 본인인증한 일반 계정이다.
// ---------------------------------------------------------------------------

/// 본인인증 결과. 생년월일은 저장하지 않고, 미성년자는 만 19세가 되는 날만 남긴다
model IdentityVerification {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  legalName  String
  isMinor    Boolean
  /// 미성년자가 만 19세가 되는 날. 성인이면 null
  adultOn    DateTime?
  verifiedAt DateTime  @default(now())
}

enum TalentKind {
  ACTOR
  GENERAL
}

enum TalentStatus {
  PENDING_VERIFICATION
  ACTIVE
  WITHDRAWING
  WITHDRAWN
}

/// 장면 유형. 배역 태그 ⊆ 출연자 허용 태그여야 제안할 수 있고, 작품 태그 ⊆ 계약 태그여야 공개할 수 있다
enum ContentTag {
  ROMANCE
  INTIMACY
  VIOLENCE
  HORROR
  DEATH
  SUBSTANCE
  PROFANITY
}

model TalentProfile {
  id                  String       @id @default(cuid())
  userId              String       @unique
  user                User         @relation("TalentUser", fields: [userId], references: [id], onDelete: Cascade)
  kind                TalentKind
  stageName           String
  bio                 String?
  status              TalentStatus @default(PENDING_VERIFICATION)
  allowedTags         ContentTag[]
  /// 받을 수 있는 최저 출연료 (원). 기획사 제안의 보장액이 이보다 낮으면 거절된다
  minFeeKrw           Int          @default(0)
  livenessVerifiedAt  DateTime?
  consentVersion      String?
  consentedAt         DateTime?
  /// 미성년자: 보호자가 가입할 이메일, 그다음 연결된 보호자 계정
  guardianEmail       String?
  guardianId          String?
  guardian            User?        @relation("TalentGuardian", fields: [guardianId], references: [id])
  guardianConsentAt   DateTime?
  /// 관리자가 가족관계증명서 등으로 관계를 확인한 시각
  guardianVerifiedAt  DateTime?
  withdrawRequestedAt DateTime?
  /// 원본·모델을 삭제할 시각 (숙려 기간과 진행 중 계약의 제작 기한 중 늦은 날)
  purgeAfter          DateTime?
  withdrawnAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  assets       LikenessAsset[]
  negotiations CastingNegotiation[]
  contracts    CastingContract[]

  @@index([status])
}

enum LikenessAssetKind {
  FACE_SCAN
  VOICE
  MOTION
}

enum LikenessAssetStatus {
  ACTIVE
  DELETED
}

/// 암호화된 초상 원본. 파일 내용은 저장소(LikenessStorage)에 있고 DB에는 없다
model LikenessAsset {
  id          String              @id @default(cuid())
  talentId    String
  talent      TalentProfile       @relation(fields: [talentId], references: [id], onDelete: Cascade)
  kind        LikenessAssetKind
  storageKey  String              @unique
  contentType String
  sizeBytes   Int
  sha256      String
  /// 파일별 데이터 키를 마스터 키로 감싼 값. 삭제할 때 지운다 (백업 사본까지 복구 불가)
  wrappedKey  String?
  status      LikenessAssetStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  deletedAt   DateTime?

  accessLogs LikenessAccessLog[]

  @@index([talentId, status])
}

model LikenessAccessLog {
  id         String           @id @default(cuid())
  assetId    String
  asset      LikenessAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  contractId String?
  contract   CastingContract? @relation(fields: [contractId], references: [id])
  purpose    String
  accessedAt DateTime         @default(now())

  @@index([assetId, accessedAt])
}

/// 딜의 작가와 제작자(= 기획사)가 만드는 작품. 딜 하나에 하나
model Project {
  id        String   @id @default(cuid())
  dealId    String   @unique
  deal      Deal     @relation(fields: [dealId], references: [id])
  title     String
  createdAt DateTime @default(now())

  roles     CastingRole[]
  contracts CastingContract[]
  works     Work[]
}

enum CastingRoleStatus {
  OPEN
  CAST
  CLOSED
}

model CastingRole {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// 만 19세 미만 인물. 누가 연기하든 미성년자 제한이 적용된다
  isMinorRole Boolean           @default(false)
  contentTags ContentTag[]
  status      CastingRoleStatus @default(OPEN)
  createdAt   DateTime          @default(now())

  negotiations CastingNegotiation[]
  contracts    CastingContract[]

  @@index([status])
}

enum CastingSide {
  STUDIO
  TALENT
}

enum CastingNegotiationStatus {
  OPEN
  AGREED
  CLOSED
}

model CastingNegotiation {
  id          String                   @id @default(cuid())
  roleId      String
  role        CastingRole              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  talentId    String
  talent      TalentProfile            @relation(fields: [talentId], references: [id], onDelete: Cascade)
  initiatedBy CastingSide
  message     String?
  status      CastingNegotiationStatus @default(OPEN)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  offers   CastingOffer[]
  contract CastingContract?

  @@unique([roleId, talentId])
}

enum FeeType {
  FLAT
  PER_EPISODE
  REVENUE_SHARE
  HYBRID
}

enum UsageScope {
  DIGITAL
  LIVE
  BOTH
}

enum CastingOfferStatus {
  PROPOSED
  COUNTERED
  WITHDRAWN
  PENDING_GUARDIAN
  REJECTED_BY_GUARDIAN
  ACCEPTED
}

model CastingOffer {
  id                     String             @id @default(cuid())
  negotiationId          String
  negotiation            CastingNegotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  proposerId             String
  proposer               User               @relation(fields: [proposerId], references: [id])
  side                   CastingSide
  feeType                FeeType
  /// 고정 출연료 (원). FLAT, HYBRID
  flatFeeKrw             Int                @default(0)
  /// 회당 출연료 (원). PER_EPISODE
  perEpisodeFeeKrw       Int                @default(0)
  episodes               Int?
  /// 작품 순수익 중 배분 비율(%). REVENUE_SHARE, HYBRID
  revenueSharePct        Int                @default(0)
  usage                  UsageScope
  termMonths             Int
  exclusive              Boolean
  /// 출연분 확인권: 출연자가 작품마다 확인해야 공개할 수 있다
  requiresTalentApproval Boolean            @default(true)
  /// 계약일부터 새 장면을 제작할 수 있는 기간 (최대 90일)
  productionDays         Int
  /// 조기 종료 보상: 고정 출연료 반환 + 이 비율(%)
  earlyTerminationPct    Int                @default(50)
  note                   String?
  status                 CastingOfferStatus @default(PROPOSED)
  respondedAt            DateTime?
  createdAt              DateTime           @default(now())

  contract CastingContract?

  @@index([negotiationId, createdAt])
}

enum CastingContractStatus {
  ACTIVE
  TERMINATED
  EXPIRED
}

/// 출연 계약 + 초상 사용 라이선스. 수락한 제안의 조건을 복사해 둔다
model CastingContract {
  id                     String                @id @default(cuid())
  negotiationId          String                @unique
  negotiation            CastingNegotiation    @relation(fields: [negotiationId], references: [id])
  offerId                String                @unique
  offer                  CastingOffer          @relation(fields: [offerId], references: [id])
  projectId              String
  project                Project               @relation(fields: [projectId], references: [id])
  roleId                 String
  role                   CastingRole           @relation(fields: [roleId], references: [id])
  talentId               String
  talent                 TalentProfile         @relation(fields: [talentId], references: [id])
  feeType                FeeType
  flatFeeKrw             Int
  perEpisodeFeeKrw       Int
  episodes               Int?
  revenueSharePct        Int
  usage                  UsageScope
  contentTags            ContentTag[]
  exclusive              Boolean
  requiresTalentApproval Boolean
  earlyTerminationPct    Int
  guardianApprovedAt     DateTime?
  startsAt               DateTime
  productionEndsAt       DateTime
  endsAt                 DateTime
  status                 CastingContractStatus @default(ACTIVE)
  terminatedAt           DateTime?
  terminationReason      String?
  createdAt              DateTime              @default(now())

  appearances    WorkAppearance[]
  likenessAccess LikenessAccessLog[]

  @@index([talentId, status])
}

enum WorkStatus {
  DRAFT
  PUBLISHED
  UNLISTED
  REMOVED
}

/// 계약으로 만든 결과물 (회차, 숏폼 등)
model Work {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  contentTags ContentTag[]
  /// AI로 만든 초상을 썼는지. 공개할 때 합성 콘텐츠 표시가 필요하다
  aiGenerated Boolean      @default(true)
  externalUrl String?
  status      WorkStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  appearances  WorkAppearance[]
  takedowns    TakedownRequest[]
  performances WorkPerformanceSnapshot[]
}

model WorkAppearance {
  workId     String
  work       Work            @relation(fields: [workId], references: [id], onDelete: Cascade)
  contractId String
  contract   CastingContract @relation(fields: [contractId], references: [id])
  approvedAt DateTime?

  @@id([workId, contractId])
}

enum TakedownReason {
  OUT_OF_SCOPE
  PROHIBITED_CONTENT
  NOT_APPROVED
  IDENTITY_FRAUD
  MINOR_PROTECTION
  PERSONALITY_HARM
  PERSONAL_WITHDRAWAL
}

enum TakedownStatus {
  OPEN
  UPHELD
  REJECTED
  SETTLED
}

model TakedownRequest {
  id              String         @id @default(cuid())
  workId          String
  work            Work           @relation(fields: [workId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User           @relation("TakedownRequester", fields: [requesterId], references: [id])
  reason          TakedownReason
  details         String
  /// 신고하자마자 자동으로 비공개 처리했는지
  interimUnlisted Boolean
  status          TakedownStatus @default(OPEN)
  /// 자동 비공개된 신고의 관리자 판단 기한
  reviewDueAt     DateTime?
  decidedById     String?
  decidedBy       User?          @relation("TakedownDecider", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  resolution      String?
  createdAt       DateTime       @default(now())

  @@index([status, createdAt])
}

/// 공개된 작품의 성과 기록 (흥행 판단 모델의 정답 데이터). 지금은 기획사·관리자가 직접 입력하고, 나중에 유튜브 분석 API로 채운다
model WorkPerformanceSnapshot {
  id                 String   @id @default(cuid())
  workId             String
  work               Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  /// 이 숫자를 확인한 시각
  capturedAt         DateTime
  views              Int
  /// 총 시청 시간 (분)
  watchTimeMinutes   Int?
  /// 평균 시청 지속 시간 (초)
  avgViewDurationSec Int?
  likes              Int?
  comments           Int?
  /// 긍정 댓글 수 (직접 세거나 댓글 감성 분석으로 센 값)
  positiveComments   Int?
  /// 영상 공개 시점의 채널 구독자 수. 채널 크기 차이를 걷어내는 데 쓴다
  channelSubscribers Int?
  subscribersGained  Int?
  /// 이 시점까지의 누적 수익 (원)
  revenueKrw         Int?
  /// MANUAL(직접 입력) / YOUTUBE_API
  source             String   @default("MANUAL")
  recordedById       String
  recordedBy         User     @relation(fields: [recordedById], references: [id])
  createdAt          DateTime @default(now())

  @@index([workId, capturedAt])
}

/// 대본 벡터 (docs/hit-model.md). ML 서비스(services/ml)가 본문을 장면으로 나눠 만든다.
/// 원문은 DB 밖으로 내보내지 않고, 학습에는 이 벡터와 작품 성과만 쓴다.
model ScriptEmbedding {
  id           String   @id @default(cuid())
  scriptId     String
  script       Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  /// 임베더 이름·버전 (예: hash-ngram-v1, bge-m3). 임베더가 바뀌면 행을 새로 만든다
  embedder     String
  dims         Int
  sceneCount   Int
  /// 장면 벡터를 길이로 가중 평균하고 정규화한 대본 전체 벡터
  pooled       Float[]
  /// 장면 벡터를 순서대로 이어 붙인 것 (sceneCount × dims). 장면 흐름 분석용
  sceneVectors Float[]
  /// 구조 특징 (장면 수, 대사 비율, 인물 수 등)
  features     Json
  /// 벡터를 만든 본문의 sha256. 본문이 바뀌면 다시 만든다
  textHash     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scriptId, embedder])
}

/// 학습한 흥행 판단 모델의 버전. 활성 버전은 하나뿐이다 (ML 서비스가 관리한다)
model HitModelVersion {
  id              String   @id @default(cuid())
  version         String   @unique
  embedder        String
  /// 예: logreg-l2-bootstrap
  algorithm       String
  /// 정답 정의 (예: reach+engagement z점수 상위 20%)
  labelDefinition String
  trainingPairs   Int
  /// 시간 순서 검증 결과 (AUC, 상위 20% 적중률, 브라이어 점수, 장르 평균 대비 등)
  metrics         Json
  /// ML 서비스 모델 볼륨 안의 파일 경로
  artifactPath    String
  active          Boolean  @default(false)
  trainedAt       DateTime @default(now())
}

// ---------- 계약·영상 게시·정산 (docs/business-model.md, docs/contracts-schema-proposal.md) ----------

enum ContractKind {
  NDA
  SCRIPT_LICENSE
  CHANNEL_PUBLISHING
}

enum ContractStatus {
  AWAITING_SIGNATURES
  SIGNED
  VOID
  /// 변경 계약이 서명되어 대체됨 (대체 전 수익에는 계속 적용)
  SUPERSEDED
}

enum ContractPartyRole {
  WRITER
  PRODUCER
  PLATFORM
  /// 출연자 (배우 시장이 열리면 변경 계약으로 더한다)
  PERFORMER
  /// 공동 제작자 등 그 밖의 참여자
  OTHER
}

model Contract {
  id              String               @id @default(cuid())
  kind            ContractKind
  templateVersion String
  title           String
  body            String               @db.Text
  bodySha256      String
  status          ContractStatus       @default(AWAITING_SIGNATURES)
  /// 대본 이용허락 계약이면 딜. 변경 계약이 생기면 한 딜에 여러 계약이 이어진다
  dealId          String?
  deal            Deal?                @relation(fields: [dealId], references: [id])
  /// 이 계약이 바꾸는 이전 계약 (변경 계약)
  supersedesId    String?              @unique
  supersedes      Contract?            @relation("ContractAmendment", fields: [supersedesId], references: [id])
  supersededBy    Contract?            @relation("ContractAmendment")
  /// 수익 배분이 적용되기 시작하는 달 (YYYY-MM). null이면 처음부터
  effectiveMonth  String?
  accessRequestId String?              @unique
  accessRequest   ScriptAccessRequest? @relation(fields: [accessRequestId], references: [id])
  createdAt       DateTime             @default(now())
  signedAt        DateTime?
  voidedAt        DateTime?
  voidReason      String?

  parties  ContractParty[]
  revenues VideoRevenue[]

  @@index([kind, status])
  @@index([dealId])
}

model ContractParty {
  id                String            @id @default(cuid())
  contractId        String
  contract          Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  role              ContractPartyRole
  userId            String?
  user              User?             @relation(fields: [userId], references: [id])
  /// 계약서에 적힌 이름 (만들 때 고정)
  legalName         String
  /// 같은 역할이 여럿일 때 구분 (예: 공동 작가, 주연 배우)
  label             String?
  /// 영상 광고 수익 배분율 (만분율, 10000 = 100%). 배분받지 않으면 null
  revenueShareBp    Int?
  /// 원 단위 내림으로 남는 금액을 받는 당사자 (계약마다 정확히 하나)
  receivesRemainder Boolean           @default(false)
  signedAt          DateTime?
  signedName        String?
  ip                String?
  userAgent         String?

  payouts SettlementPayout[]

  @@unique([contractId, userId])
  @@index([contractId, role])
  @@index([userId])
}

enum ChannelVideoStatus {
  SUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
  REMOVED
}

model ChannelVideo {
  id              String             @id @default(cuid())
  dealId          String
  deal            Deal               @relation(fields: [dealId], references: [id])
  producerId      String
  producer        User               @relation("ChannelVideoProducer", fields: [producerId], references: [id])
  title           String
  description     String?            @db.Text
  /// 검수용 영상 위치는 둘 중 하나: 제작자가 준 링크(sourceUrl) 또는 우리 저장소에 올린 파일(fileKey)
  sourceUrl       String?
  /// 저장소 안 파일 이름 (deals/<딜>/<무작위>/<파일 이름>). 검수가 끝나면 지우고 fileDeletedAt을 남긴다
  fileKey         String?            @unique
  fileName        String?
  fileSizeBytes   Int?
  fileDeletedAt   DateTime?
  rightsChecklist Json
  status          ChannelVideoStatus @default(SUBMITTED)
  reviewNote      String?
  reviewedById    String?
  reviewedBy      User?              @relation("ChannelVideoReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  channelName     String?
  youtubeVideoId  String?            @unique
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  revenues VideoRevenue[]

  @@index([dealId])
  @@index([status])
}

model VideoRevenue {
  id          String       @id @default(cuid())
  videoId     String
  video       ChannelVideo @relation(fields: [videoId], references: [id])
  month       String
  amountKrw   Int
  /// 이 수익을 나눌 때 적용한 계약 (기록 시점에 고정)
  contractId  String?
  contract    Contract?    @relation(fields: [contractId], references: [id])
  memo        String?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  payouts SettlementPayout[]

  @@unique([videoId, month])
}

model SettlementPayout {
  id          String            @id @default(cuid())
  revenueId   String
  revenue     VideoRevenue      @relation(fields: [revenueId], references: [id])
  /// 받은 당사자 (적용한 계약의 당사자 한 명)
  partyId     String
  party       ContractParty     @relation(fields: [partyId], references: [id])
  role        ContractPartyRole
  recipientId String
  recipient   User              @relation("PayoutRecipient", fields: [recipientId], references: [id])
  amountKrw   Int
  paidAt      DateTime
  memo        String?
  createdById String
  createdBy   User              @relation("PayoutCreator", fields: [createdById], references: [id])

  @@unique([revenueId, partyId])
}

// ---------- 문의 게시판 (도움말 > 문의하기) ----------

enum InquiryCategory {
  ACCOUNT
  COINS
  SCRIPTS
  CONTRACTS
  VIDEOS
  OTHER
}

/// 답변 대기 → (운영자 답변) 답변 완료 → (작성자가 더 물으면) 답변 대기 … → 해결됨
enum InquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Inquiry {
  id             String          @id @default(cuid())
  authorId       String
  author         User            @relation("InquiryAuthor", fields: [authorId], references: [id])
  category       InquiryCategory
  title          String
  body           String          @db.Text
  /// 비밀 문의: 작성자와 운영자만 본다 (다른 사람에게는 제목도 가린다)
  isPrivate      Boolean         @default(true)
  status         InquiryStatus   @default(OPEN)
  /// 운영자가 숨긴 시각 (스팸·부적절한 글). 숨기면 운영자만 본다
  hiddenAt       DateTime?
  /// 마지막 글(문의·답글)이 달린 시각. 목록 정렬에 쓴다
  lastActivityAt DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  replies InquiryReply[]

  @@index([status, lastActivityAt])
  @@index([authorId])
}

model InquiryReply {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("InquiryReplyAuthor", fields: [authorId], references: [id])
  /// 운영자 답변인가 (아니면 작성자의 추가 질문)
  fromStaff Boolean
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}
