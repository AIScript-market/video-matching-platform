// 계약 ERD (CLAUDE 계약 문서 기준). 컨벤션: @@map 없음(테이블명=모델명), id는 cuid,
// 금액은 원 단위 Int, 시간은 UTC DateTime. 각자 자기 모델만 수정하고 마이그레이션 이름에 a-/b- 접두어.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 계정 종류는 일반(roles = [])과 관리자(ADMIN) 두 가지. WRITER·PRODUCER는 이전 계약 호환용으로만 남아 있고 쓰지 않는다
enum Role {
  WRITER
  PRODUCER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED // 관리자가 정지. 이 이메일로는 다시 가입할 수 없다
  WITHDRAWN // 탈퇴. 이메일을 비워 두어 같은 이메일로 다시 가입할 수 있다
}

enum CoinTxType {
  SIGNUP_BONUS
  PURCHASE
  SPEND
  ADMIN_ADJUST
}

// 코인을 쓰는 곳
enum CoinUse {
  MESSAGE
  PREVIEW_UNLOCK
  SCRIPT_UPLOAD
}

enum ScriptStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NegotiationStatus {
  OPEN
  AGREED
  CLOSED
}

enum OfferStatus {
  PROPOSED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DealStatus {
  PENDING_CONTRACT
  ACTIVE
  TERMINATED
}

enum LicenseStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum LedgerEntryType {
  REVENUE
  PAYOUT
  FEE
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  roles        Role[]
  createdAt    DateTime @default(now())

  /// 공개 프로필 소개. 대본 제공·영상 제작을 하려면 프로필과 이메일을 공개해야 한다
  bio           String?
  profilePublic Boolean    @default(false)
  emailPublic   Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  suspendedAt   DateTime?
  suspendReason String?
  withdrawnAt   DateTime?
  coinBalance   Int        @default(0)

  scripts              Script[]
  accessRequests       ScriptAccessRequest[]
  accessLogs           ScriptAccessLog[]
  writerNegotiations   Negotiation[]         @relation("NegotiationWriter")
  producerNegotiations Negotiation[]         @relation("NegotiationProducer")
  messages             Message[]
  offers               Offer[]
  licenses             License[]
  ledgerEntries        LedgerEntry[]
  scriptUploads        ScriptUpload[]
  coinTransactions     CoinTransaction[]
  previewUnlocks       ScriptPreviewUnlock[]
}

model Script {
  id                   String       @id @default(cuid())
  authorId             String
  author               User         @relation(fields: [authorId], references: [id])
  title                String
  logline              String
  synopsis             String
  genre                String
  fullText             String       @db.Text
  status               ScriptStatus @default(DRAFT)
  rightsDeclared       Boolean      @default(false)
  rightsDeclaredAt     DateTime?
  aiSummary            Json?
  /// 마지막으로 AI 요약을 요청한 시각. aiSummary.generatedAt보다 나중이면 새 요약을 만드는 중
  aiSummaryRequestedAt DateTime?
  /// 제작자에게 열람 승인 전에 보여줄 일부분 (선택)
  previewText          String?      @db.Text
  /// 내용(제목·로그라인·시놉시스·장르·전문·미리보기)이 마지막으로 바뀐 시각. 공개·숨김 같은 상태 변경은 포함하지 않는다
  contentUpdatedAt     DateTime     @default(now())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  accessRequests ScriptAccessRequest[]
  accessLogs     ScriptAccessLog[]
  negotiations   Negotiation[]
  licenses       License[]
  uploads        ScriptUpload[]
  previewUnlocks ScriptPreviewUnlock[]
}

model ScriptAccessRequest {
  id            String              @id @default(cuid())
  scriptId      String
  script        Script              @relation(fields: [scriptId], references: [id])
  producerId    String
  producer      User                @relation(fields: [producerId], references: [id])
  status        AccessRequestStatus @default(PENDING)
  ndaAcceptedAt DateTime
  decidedAt     DateTime?

  @@unique([scriptId, producerId])
}

model ScriptAccessLog {
  id       String   @id @default(cuid())
  scriptId String
  script   Script   @relation(fields: [scriptId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  viewedAt DateTime @default(now())
}

model Negotiation {
  id         String            @id @default(cuid())
  scriptId   String
  script     Script            @relation(fields: [scriptId], references: [id])
  writerId   String
  writer     User              @relation("NegotiationWriter", fields: [writerId], references: [id])
  producerId String
  producer   User              @relation("NegotiationProducer", fields: [producerId], references: [id])
  status     NegotiationStatus @default(OPEN)
  createdAt  DateTime          @default(now())

  messages Message[]
  offers   Offer[]
  deal     Deal?

  @@unique([scriptId, producerId])
}

model Message {
  id            String      @id @default(cuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id])
  body          String
  createdAt     DateTime    @default(now())
}

model Offer {
  id               String      @id @default(cuid())
  negotiationId    String
  negotiation      Negotiation @relation(fields: [negotiationId], references: [id])
  proposerId       String
  proposer         User        @relation(fields: [proposerId], references: [id])
  writerSharePct   Int
  producerSharePct Int
  upfrontFeeKrw    Int
  termMonths       Int
  exclusive        Boolean
  notes            String?
  status           OfferStatus @default(PROPOSED)
  createdAt        DateTime    @default(now())
}

model Deal {
  id              String      @id @default(cuid())
  negotiationId   String      @unique
  negotiation     Negotiation @relation(fields: [negotiationId], references: [id])
  acceptedOfferId String
  status          DealStatus  @default(PENDING_CONTRACT)
  createdAt       DateTime    @default(now())

  licenses      License[]
  ledgerEntries LedgerEntry[]
}

model License {
  id                String        @id @default(cuid())
  dealId            String
  deal              Deal          @relation(fields: [dealId], references: [id])
  scriptId          String
  script            Script        @relation(fields: [scriptId], references: [id])
  licenseeId        String
  licensee          User          @relation(fields: [licenseeId], references: [id])
  scope             String        @db.Text
  startsAt          DateTime?
  endsAt            DateTime?
  status            LicenseStatus @default(DRAFT)
  terminationReason String?
}

model LedgerEntry {
  id          String          @id @default(cuid())
  dealId      String
  deal        Deal            @relation(fields: [dealId], references: [id])
  type        LedgerEntryType
  amountKrw   Int
  memo        String?
  occurredAt  DateTime
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
}


enum UploadKind {
  FULL // 대본 전문
  PREVIEW // 미리보기 대본
}

// 대본 파일 업로드 기록 (관리자 로그용). 원본 파일은 저장하지 않고 추출한 본문만 Script.fullText에 넣는다
model ScriptUpload {
  id         String     @id @default(cuid())
  scriptId   String
  script     Script     @relation(fields: [scriptId], references: [id])
  uploaderId String
  uploader   User       @relation(fields: [uploaderId], references: [id])
  kind       UploadKind @default(FULL)
  filename   String
  mimeType   String
  sizeBytes  Int
  charCount  Int
  createdAt  DateTime   @default(now())

  @@index([createdAt])
}

// 코인 거래 원장. amount는 + 충전 / - 사용, balanceAfter는 거래 직후 잔액
model CoinTransaction {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  type         CoinTxType
  amount       Int
  balanceAfter Int
  use          CoinUse?
  /// 사용처 대상 id (메시지·대본 등)
  refId        String?
  /// 구매 시 결제 금액 (원)
  priceKrw     Int?
  memo         String?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// 미리보기 대본 열람권 (코인으로 한 번 사면 계속 볼 수 있다)
model ScriptPreviewUnlock {
  id        String   @id @default(cuid())
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([scriptId, userId])
}
