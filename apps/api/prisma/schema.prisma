// 계약 ERD (CLAUDE 계약 문서 기준). 컨벤션: @@map 없음(테이블명=모델명), id는 cuid,
// 금액은 원 단위 Int, 시간은 UTC DateTime. 각자 자기 모델만 수정하고 마이그레이션 이름에 a-/b- 접두어.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  WRITER
  PRODUCER
  ADMIN
}

enum ScriptStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NegotiationStatus {
  OPEN
  AGREED
  CLOSED
}

enum OfferStatus {
  PROPOSED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DealStatus {
  PENDING_CONTRACT
  ACTIVE
  TERMINATED
}

enum LicenseStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum LedgerEntryType {
  REVENUE
  PAYOUT
  FEE
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  roles        Role[]
  createdAt    DateTime @default(now())

  scripts              Script[]
  accessRequests       ScriptAccessRequest[]
  accessLogs           ScriptAccessLog[]
  writerNegotiations   Negotiation[]         @relation("NegotiationWriter")
  producerNegotiations Negotiation[]         @relation("NegotiationProducer")
  messages             Message[]
  offers               Offer[]
  licenses             License[]
  ledgerEntries        LedgerEntry[]
}

model Script {
  id               String       @id @default(cuid())
  authorId         String
  author           User         @relation(fields: [authorId], references: [id])
  title            String
  logline          String
  synopsis         String
  genre            String
  fullText         String       @db.Text
  status           ScriptStatus @default(DRAFT)
  rightsDeclared   Boolean      @default(false)
  rightsDeclaredAt DateTime?
  aiSummary        Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  accessRequests ScriptAccessRequest[]
  accessLogs     ScriptAccessLog[]
  negotiations   Negotiation[]
  licenses       License[]
}

model ScriptAccessRequest {
  id            String              @id @default(cuid())
  scriptId      String
  script        Script              @relation(fields: [scriptId], references: [id])
  producerId    String
  producer      User                @relation(fields: [producerId], references: [id])
  status        AccessRequestStatus @default(PENDING)
  ndaAcceptedAt DateTime
  decidedAt     DateTime?

  @@unique([scriptId, producerId])
}

model ScriptAccessLog {
  id       String   @id @default(cuid())
  scriptId String
  script   Script   @relation(fields: [scriptId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  viewedAt DateTime @default(now())
}

model Negotiation {
  id         String            @id @default(cuid())
  scriptId   String
  script     Script            @relation(fields: [scriptId], references: [id])
  writerId   String
  writer     User              @relation("NegotiationWriter", fields: [writerId], references: [id])
  producerId String
  producer   User              @relation("NegotiationProducer", fields: [producerId], references: [id])
  status     NegotiationStatus @default(OPEN)
  createdAt  DateTime          @default(now())

  messages Message[]
  offers   Offer[]
  deal     Deal?

  @@unique([scriptId, producerId])
}

model Message {
  id            String      @id @default(cuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id])
  body          String
  createdAt     DateTime    @default(now())
}

model Offer {
  id               String      @id @default(cuid())
  negotiationId    String
  negotiation      Negotiation @relation(fields: [negotiationId], references: [id])
  proposerId       String
  proposer         User        @relation(fields: [proposerId], references: [id])
  writerSharePct   Int
  producerSharePct Int
  upfrontFeeKrw    Int
  termMonths       Int
  exclusive        Boolean
  notes            String?
  status           OfferStatus @default(PROPOSED)
  createdAt        DateTime    @default(now())
}

model Deal {
  id              String      @id @default(cuid())
  negotiationId   String      @unique
  negotiation     Negotiation @relation(fields: [negotiationId], references: [id])
  acceptedOfferId String
  status          DealStatus  @default(PENDING_CONTRACT)
  createdAt       DateTime    @default(now())

  licenses      License[]
  ledgerEntries LedgerEntry[]
}

model License {
  id                String        @id @default(cuid())
  dealId            String
  deal              Deal          @relation(fields: [dealId], references: [id])
  scriptId          String
  script            Script        @relation(fields: [scriptId], references: [id])
  licenseeId        String
  licensee          User          @relation(fields: [licenseeId], references: [id])
  scope             String        @db.Text
  startsAt          DateTime?
  endsAt            DateTime?
  status            LicenseStatus @default(DRAFT)
  terminationReason String?
}

model LedgerEntry {
  id          String          @id @default(cuid())
  dealId      String
  deal        Deal            @relation(fields: [dealId], references: [id])
  type        LedgerEntryType
  amountKrw   Int
  memo        String?
  occurredAt  DateTime
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
}
